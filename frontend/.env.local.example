# Copy this file to .env.local and fill in the values

# Your deployed AWS API Gateway URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com

# Google OAuth 2.0 Web Client ID from console.cloud.google.com
# Leave blank to disable the "Continue with Google" button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
